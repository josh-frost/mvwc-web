# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

#local IDE files
.vscode/
.idea/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sanity TypeGen: schema.json is an intermediate file (regenerated by `npm run typegen`);
# sanity.types.ts is committed.
/schema.json
